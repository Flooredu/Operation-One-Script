-- traps + drones + the explosives worth shooting, that aimbot and silent aim may
-- lock onto. derived from GADGETS so a name can never be listed in two places
-- and drift: anything filed under obj_traps or obj_cam is aim-targetable, and
-- it carries the ESP label with it. DefaultCamera is excluded on purpose - that
-- is the player's own map widget, not a world object, and it would otherwise
-- drag the crosshair to the HUD.
--
-- the second list is explicit rather than "include all of obj_breach": taking
-- that category wholesale would also sweep in BreachCharge, HardBreachCharge
-- and ThermiteCharge, which is a wider net than was asked for. names are pulled
-- from GADGETS by key so the label still has one source of truth.
--
--   RemoteC4           - the C4
--   IncendiaryCanister - the incendiary canister
--   SignalDisruptor    - jammers, under obj_util
local AIM_EXTRA={RemoteC4=true,IncendiaryCanister=true,SignalDisruptor=true}
local AIM_TARGETS={}
for n,g in pairs(GADGETS) do
  if ((g[2]=="obj_traps" or g[2]=="obj_cam") and n~="DefaultCamera") or AIM_EXTRA[n] then
    AIM_TARGETS[n]=g[1]
  end
end
-- skip lists match the grenade scan: Backpack/StarterGear hold the player's own
-- undropped gear, and WarehouseMenu is 20+ preview Models sitting in Workspace
-- that would otherwise register as live traps.
local AIM_SKIPCLS={Backpack=true,StarterGear=true,PlayerGui=true,CoreGui=true,RemoteEvent=true}
local AIM_SKIPNAME={WarehouseMenu=true,Packages=true,Items=true}
local aim_gad_parts={}; local aim_gad_plast=-1
local function aim_gad_scan(inst,depth)
  for _,c in ipairs(call(function() return inst:GetChildren() end) or {}) do
    local cn,nm
    if not pcall(function() cn=c.ClassName end) then cn="" end
    if not pcall(function() nm=c.Name end) then nm="" end
    if not (AIM_SKIPCLS[cn] or AIM_SKIPNAME[nm]) then
      local lb=AIM_TARGETS[nm]
      if lb then
        local prt=find_part(c,3); if prt then aim_gad_parts[#aim_gad_parts+1]={prt=prt,lb=lb} end
      elseif depth>0 and (cn=="Model" or cn=="Folder") then
        aim_gad_scan(c,depth-1)
