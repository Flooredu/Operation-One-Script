    end
  end
end
local function scan_gadgets()
  local t=now()
  if t-aim_gad_plast>0.2 then aim_gad_plast=t
    aim_gad_parts={}; local ws=game.Workspace; if ws then pcall(aim_gad_scan,ws,2) end
  end
  gadget_cache={}
  for _,g in ipairs(aim_gad_parts) do
    local prt=g.prt
