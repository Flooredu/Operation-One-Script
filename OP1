      local pw=48; local gap=7; local pad=16
      local tot=#feats*pw+(#feats-1)*gap+pad*2
      local ph=34; local bp=hud_pos.bar
      local bx=bp and bp.x or (sw*0.5-tot*0.5); local by=bp and bp.y or (sh-ph-18)
      if bx+tot>sw then bx=sw-tot end; if bx<0 then bx=0 end
      if by+ph>sh then by=sh-ph end
      if ui.open and inside(bx,by,tot,ph) and ui.m.click and not ui.drag then
        hud_pos.bar={x=bx,y=by}
        ui.drag={k="hud_bar",ox=ui.m.x-bx,oy=ui.m.y-by}; ui.m.click=false
      end
      hud_panel(bx,by,tot,ph,apb,4)
      if ui.open then
        local bgx,bgy=bx+tot-14,by+2
        for r=0,1 do for cc=0,1 do draw.RectFilled(bgx+cc*4,bgy+r*4,1.6,1.6,a(theme.faint,0.9*apb),0) end end
      end
      local e=mix(theme.accent,theme.accent2,0.5)
      draw.RectFilled(bx+pad-2,by+ph-2,tot-(pad-2)*2,2, {e[1],e[2],e[3],0.9*apb}, 1)
      for i,lb in ipairs(feats) do
        local px=bx+pad+(i-1)*(pw+gap)
        draw.CircleFilled(px+pw*0.5, by+11, 2.4, a(e,0.95*apb), 12)
        local tw=ts(lb,10)
        draw.Text(px+pw*0.5-tw*0.5, by+17, lb, a(theme.text,0.95*apb), 10)
        if i<#feats then
          local sx=px+pw+gap*0.5
          draw.Line(sx,by+9,sx,by+ph-10, a(theme.line,0.5*apb), 1)
        end
      end
    end
  end
end

local SILENT_BONE={"head","torso","hip1","arm1","leg1","head"}
local silent_hook=false
local silent_track=nil
local silent_bone_lock=nil
local silent_target=nil
local SILENT_VK=0x01

local function rfn(pascal,snake) return raycast[pascal] or raycast[snake] end
local R_enable  = rfn("EnableSilentHook","enable_silent_hook")
local R_active  = rfn("IsSilentHookActive","is_silent_hook_active")
local R_set     = rfn("SetSilentTarget","set_silent_target")
local R_track   = rfn("TrackSilentTarget","track_silent_target")
local R_clear   = rfn("ClearSilentTarget","clear_silent_target")
local R_stop    = rfn("StopSilentTracking","stop_silent_tracking")
local R_disable = rfn("DisableSilentHook","disable_silent_hook")

local function silent_release()
  if R_stop then pcall(R_stop) end
  if R_clear then pcall(R_clear) end
end

local function silent_send(origin, dir)
  if silent_track==nil then silent_track = type(R_track)=="function" end
  if silent_track then
    return (pcall(function() R_track(origin, dir, SILENT_VK) end))
  end
  if R_set then return (pcall(function() R_set(origin, dir) end)) end
  return false
end

local function silent_enable()
  local active=false
  pcall(function() if R_active then active=R_active()==true end end)
  if active then silent_hook=true; return true end
  local ok=false; pcall(function() if R_enable then ok=R_enable() end end)
  silent_hook = ok==true
  return silent_hook
end
local function run_silent()
  if not cfg.silent_on then
    if silent_hook then silent_release(); if R_disable then pcall(R_disable) end; silent_hook=false end
    silent_bone_lock=nil; silent_target=nil
    return
  end
  if not silent_hook and not silent_enable() then return end
  local sw,sh=scr(); local cx,cy=sw*0.5,sh*0.5

  if cfg.silent_vis then fov_draw(cfg.silent_fovstyle,cfg.silent_fov,cx,cy,cfg.silent_fovchroma and chroma() or col.c_silent,0.7) end
  -- like the camera line: select a target every frame so the line is a live
  -- readout. only the shot override is gated on the key.
  local firing=cfg.silent_always or ekey(bind.silent_key or 0x02)
  local origin = shoot_origin()
  if not origin then silent_release(); return end
  -- candidate per player, mirroring the camera aimbot: Closest picks whichever
  -- of head/torso/hip1 projects nearest the crosshair, and sticks to that bone
  -- once chosen so the aim point cannot jitter between body parts.
  local function cand_for(p)
    if cfg.silent_team and p.friend then return nil end
    if cfg.silent_bone==6 then
      -- same hysteresis as the camera aimbot's Closest, and for the same reason:
      -- a hard bone lock turns "closest to crosshair" into "closest when the
      -- target was acquired". TUNE.bone_switch px of stickiness instead of a lock.
      local order={"head","torso","hip1","arm1","arm2","leg1","leg2"}
      local c,md=nil,1e9
      local locked=silent_bone_lock
      if locked and (p.name or p.key)~=silent_target then locked=nil end
      for _,bn in ipairs(order) do
        local b=aim_src(p,bn)
        if b then
          local sx,sy,v=W2S(b.x,b.y,b.z)
          if v then
            local d2=(sx-cx)*(sx-cx)+(sy-cy)*(sy-cy)
            local eff=(bn==locked) and math.sqrt(d2)-TUNE.bone_switch or math.sqrt(d2)
            if eff<md then md=eff; c={sx=sx,sy=sy,b=b,p=p,bn=bn,d=math.sqrt(d2)} end
          end
        end
      end
      return c
    end
    -- "Arms"/"Legs" re-pick the nearer limb every frame, with the same hysteresis
    -- the Closest option uses so the point does not flick between the two limbs.
    if cfg.silent_bone==4 or cfg.silent_bone==5 then
      local order=(cfg.silent_bone==4) and {"arm1","arm2"} or {"leg1","leg2"}
      local c,md=nil,1e9
      local locked=silent_bone_lock
      if locked and (p.name or p.key)~=silent_target then locked=nil end
      for _,bn in ipairs(order) do
        local b=aim_src(p,bn)
        if b then
          local sx,sy,v=W2S(b.x,b.y,b.z)
          if v then
            local d2=(sx-cx)*(sx-cx)+(sy-cy)*(sy-cy)
            local eff=(bn==locked) and math.sqrt(d2)-TUNE.bone_switch or math.sqrt(d2)
            if eff<md then md=eff; c={sx=sx,sy=sy,b=b,p=p,bn=bn,d=math.sqrt(d2)} end
          end
        end
      end
      return c
    end
    local bn=SILENT_BONE[cfg.silent_bone] or "head"
    local b=aim_src(p,bn) or aim_src(p,"head") or aim_src(p,"torso")
    if b then
      local sx,sy,v=W2S(b.x,b.y,b.z)
      if v then return {sx=sx,sy=sy,b=b,p=p,bn=bn,d=math.sqrt((sx-cx)*(sx-cx)+(sy-cy)*(sy-cy))} end
    end
    return nil
  end
  local function score(c)
    local m=cfg.silent_priority or 1
    if m==2 then return cam_dist(c.b.x,c.b.y,c.b.z)
    elseif m==3 then return (c.p.hp or 100)*1e4 + c.d
    else return c.d end
  end
  local best,bestv,bsx,bsy=nil,nil,nil,nil
  local bs=1e18
  -- same two-pool split, and the same strict FOV rule, as the camera aimbot: see
  -- fov_head_ok there for why the override re-tests the head rather than
  -- trusting the pool gate. box-style FOV is a square, so a corner point is
  -- visually outside the circle while still testing inside.
  local function fov_head_ok(p,style,f,cx2,cy2)
    local hb=p.bones.head or p.bones.torso
    if not hb then return false end
    local sx,sy,v=W2S(hb.x,hb.y,hb.z)
    if not v then return false end
    return fov_inside(style,f,sx,sy,cx2,cy2)
  end

  -- wall check, same contract as the camera aimbot: skipped until the visibility
  -- cache reports ready, cast to the exact bone the shot would be aimed at.
  local wall_ready=false
  if cfg.silent_wall then
    if raycast and raycast.IsReady then pcall(function() wall_ready=raycast.IsReady() end) end
  end
  local function seen(c)
    if not cfg.silent_wall or not wall_ready then return true end
    local cam=frame_cam()
    if not cam then return true end
    local ok,vis=pcall(raycast.IsVisible,cam.X,cam.Y,cam.Z,c.b.x,c.b.y,c.b.z)
    return not (ok and vis==false)
  end
  for _,p in ipairs(vm_players) do
    local c=cand_for(p)
    if c and fov_inside(cfg.silent_fovstyle,cfg.silent_fov,c.sx,c.sy,cx,cy) then local s=score(c); if s<bs and seen(c) then bs=s; best=c end end
  end
  if cfg.silent_drone then
    local gb,gs=nil,1e18
    for _,d in ipairs(gadget_cache) do
      local sx,sy,v=W2S(d.x,d.y,d.z)
      if v then
        local dd=math.sqrt((sx-cx)^2+(sy-cy)^2)
        if fov_inside(cfg.silent_fovstyle,cfg.silent_fov,sx,sy,cx,cy) then
          local c={sx=sx,sy=sy,b=d,p={name=d.lb,key=d.lb,hp=100},bn="gadget",d=dd}
          local s=score(c); if s<gs and seen(c) then gs=s; gb=c end
        end
      end
    end
    if gb then
      local use=not best
      if not use and cfg.silent_playerover then use=not fov_head_ok(best.p,cfg.silent_fovstyle,cfg.silent_fov,cx,cy) end
      if use then best=gb end
    end
  end
  if not best then silent_release(); return end
  local prev_target=silent_target
  silent_target=best.p.name or best.p.key
  -- swap drops the Closest-bone lock so the new player gets its own bone
  if prev_target~=silent_target then silent_bone_lock=nil end
  if (cfg.silent_bone==6 or cfg.silent_bone==4 or cfg.silent_bone==5) and best.bn~="gadget" then silent_bone_lock=best.bn end
  bestv=Vector3.New(best.b.x,best.b.y,best.b.z)
  local sx,sy=nil,nil
  if cfg.silent_tline then
    local px,py,v=W2S(best.b.x,best.b.y,best.b.z)
    if v then sx,sy=px,py end
  end
  bsx,bsy=sx,sy
  -- target line. visible whenever a target is acquired, key held or not - the
  -- toggle is a pure visibility control, it is not tied to firing. plain line
  -- from the crosshair to the target, no endpoint marker, own color.
  if cfg.silent_tline and bsx then
    draw.Line(cx,cy,bsx,bsy, a(col.c_silent,1), 1)
  end
  if not firing then silent_release(); return end
  if cfg.silent_magic then
    local cam=camera.GetPosition()
    if cam then
      local ok2,no=pcall(function()
        local back=cam-bestv; local m=back.Magnitude
        if m and m>0.001 then back=back*(2/m) else back=Vector3.New(0,2,0) end
        return bestv+back
      end)
      if ok2 and no then origin=no end
    end
  end
  local ok,dir=pcall(function() return bestv-origin end)
  if not ok or not dir then silent_release(); return end

  local mag; pcall(function() mag=dir.Magnitude end)
  if not mag or mag<0.05 then silent_release(); return end
  if not silent_send(origin, dir) then silent_release(); return end
end

-- triggerbot.
--
-- fires through utility.MouseClick, which is an OS-level click aimed at the
-- foreground window - the same injection path the aimbot uses for the mouse
-- move, so it works on a game that ignores synthetic input events.
--
-- gated on a pixel radius around the crosshair rather than on "is a target in
-- the aim FOV": point blank at someone while looking past them must not fire.
-- the hit point is picked from the real rig bones (aim_src), so "Any" means
-- "bone closest to the crosshair", not "closest bone by distance".
--
-- outside the game window the click would land in whatever is focused, and
-- clicking through the open menu would fire the gun instead of pressing a
-- widget, so both are refused.
local trig_next=0
-- reaction delay state. trig_hold is the identity of the target currently under
-- the crosshair and trig_dwell how long it has been there, in seconds. while the
-- identity changes - a flick, a different bone on another player, a fresh target
-- - the dwell restarts, which is what stops the first frame on someone from
-- firing instantly.
local trig_hold=nil
local trig_dwell=0
-- once a target has been held past the reaction delay it is "latched": the
-- reaction gate is a one-time entry cost, not a per-shot one. otherwise every
-- frame the target identity jitters (a bone swap, a gadget rebuilt each frame)
-- reset the dwell and re-imposed the full reaction delay on top of the click
-- delay, which is exactly the "reaction time also slows my click delay" the
-- user saw. the latch clears only when the crosshair is on nobody at all.
local trig_latch=false
-- how long the crosshair may sit on nobody before the reaction latch drops.
-- bridges the single frame dropouts that happen at a tight radius.
local trig_miss=0
local TRIG_GRACE=0.25
local function run_trigger()
  if not cfg.trig_on then trig_hold=nil; trig_dwell=0; trig_latch=false; trig_miss=0; return end
  -- cooldown runs off the frame delta instead of utility.GetTime. GetTime's
  -- resolution is not documented, and a whole-second clock made every delay
  -- setting behave the same (the gate was either always open or always shut for
  -- the rest of that second). _dt is already in seconds and is clamped by the
  -- engine, so the slider means exactly what it says at any framerate.
  if trig_next>0 then
    trig_next=trig_next-_dt
    if trig_next<0 then trig_next=0 end
  end
  if ui.open and inside(ui.x,ui.y,ui.w,ui.h) then trig_hold=nil; trig_dwell=0; trig_latch=false; trig_miss=0; return end
  if not cfg.trig_always then
    local hk=bind.trig_key or 0
    if hk==0 or not ekey(hk) then trig_hold=nil; trig_dwell=0; trig_latch=false; trig_miss=0; return end
  end
  local sw,sh=scr(); local cx,cy=sw*0.5,sh*0.5
  local rad=cfg.trig_fov or 6
  local bd=rad*rad
  local best=nil
  local mode=cfg.trig_bone or 6
  for _,p in ipairs(vm_players) do
    if not (cfg.trig_team and p.friend) then
      if mode==6 then
        for _,bn in ipairs({"head","torso","hip1","arm1","arm2","leg1","leg2"}) do
          local b=aim_src(p,bn)
          if b then
            local sx,sy,v=W2S(b.x,b.y,b.z)
            if v then
              local d2=(sx-cx)*(sx-cx)+(sy-cy)*(sy-cy)
              if d2<=bd then bd=d2; best={b=b,p=p} end
            end
          end
        end
      elseif mode==4 or mode==5 then
        -- Arms / Legs: whichever limb on that pair the crosshair is nearer,
        -- re-picked every frame.
        for _,bn in ipairs((mode==4) and {"arm1","arm2"} or {"leg1","leg2"}) do
          local b=aim_src(p,bn)
          if b then
            local sx,sy,v=W2S(b.x,b.y,b.z)
            if v then
              local d2=(sx-cx)*(sx-cx)+(sy-cy)*(sy-cy)
              if d2<=bd then bd=d2; best={b=b,p=p} end
            end
          end
        end
      else
        local b=aim_src(p,AIM_BONE[mode] or "head")
        if b then
          local sx,sy,v=W2S(b.x,b.y,b.z)
          if v then
            local d2=(sx-cx)*(sx-cx)+(sy-cy)*(sy-cy)
            if d2<=bd then bd=d2; best={b=b,p=p} end
          end
        end
      end
    end
  end
  if cfg.trig_drone then
    for _,d in ipairs(gadget_cache) do
      local sx,sy,v=W2S(d.x,d.y,d.z)
      if v then
        local d2=(sx-cx)*(sx-cx)+(sy-cy)*(sy-cy)
        if d2<=bd then bd=d2; best={b=d,g=d.lb} end
      end
    end
  end
  -- reaction delay. this is the time the trigger must be held on a target
  -- BEFORE the first shot - it is not a per-shot gate. once a target has been
  -- held past cfg.trig_react the latch stays set and every later shot is spaced
  -- purely by the click delay, so a held trigger fires full-auto instead of
  -- tapping.
  --
  -- two things used to break that and cause tap fire:
  --   * identity was the viewmodel record, which is rebuilt when the bone under
  --     the crosshair changes - a "Closest"/"Any" hitbox flips that constantly,
  --     so the dwell clock restarted before it ever reached the delay. keying on
  --     the player ADDRESS instead is stable while you are on the same body.
  --   * the latch cleared the instant best went nil for a single frame, which at
  --     a small radius happens all the time. it now survives a short dropout
  --     (TRIG_GRACE below) so micro-misses do not re-arm the reaction delay.
  local tid = best and (best.g or (best.p and best.p.ent) or best.p) or nil
  if tid~=nil and tid==trig_hold then
    trig_dwell=trig_dwell+_dt
    trig_miss=0
  elseif tid~=nil then
    trig_hold=tid; trig_dwell=0; trig_miss=0
  else
    -- no target this frame: keep the latch briefly, then drop it.
    trig_miss=trig_miss+_dt
    if trig_miss>TRIG_GRACE then trig_hold=nil; trig_dwell=0; trig_latch=false end
  end
  if tid~=nil and trig_dwell>=(cfg.trig_react or 0)/1000 then trig_latch=true end
  local ready=best~=nil and trig_latch
  if cfg.trig_show then
    local q=a(col.c_trig,0.55)
    local pts=fov_circle_pts(cx,cy,rad)
    if draw.PolyClosed then pcall(draw.PolyClosed,pts,q,1) else pcall(draw.Circle,cx,cy,rad,q,40,1) end
    if best then
      local sx,sy,v=W2S(best.b.x,best.b.y,best.b.z)
      if v then pcall(draw.RectFilled,sx-2,sy-2,4,4,a(col.c_trig,ready and 0.9 or 0.3),2) end
    end
  end
  if not ready then return end
  if trig_next>0 then return end
  if cfg.trig_wall then
    local cam=frame_cam()
    if cam then
      local ok,vis=pcall(raycast.IsVisible,cam.X,cam.Y,cam.Z,best.b.x,best.b.y,best.b.z)
      if ok and vis==false then return end
    end
  end
  trig_next=(cfg.trig_delay or 50)/1000
  pcall(utility.MouseClick,"left")
end

getgenv=getgenv or function() return _G end

-- ===== config =====
-- vector exposes no config api, but it ships the io standard library, so the
-- profile is written to disk with io.open/io.write. a copy is kept in getgenv
-- as a fallback for sandboxes where file io is blocked. json is used when
-- HttpService is reachable, otherwise a plain key=value text format.
local function cfg_env()
  local g=getgenv()
  if type(g)~="table" then return nil end
  if type(g.EGO_CFGS)~="table" then g.EGO_CFGS={} end
  return g
end
local function cfg_http()
  local ok,hs=pcall(function() return game.GetService("HttpService") end)
  if ok and hs then return hs end
  return nil
end
local cfg_last_save=0
local function cfg_save(slot,quiet)
  slot=tonumber(slot) or tonumber(cfg.cfg_slot) or 1
  local data=nil
  local hs=cfg_http()
  if hs then
    local t={v={},b={},c={}}
    for k,v in pairs(cfg) do if k~="cfg_slot" then t.v[k]=v end end
    for k,v in pairs(bind) do t.b[k]=v end
    for k,cv in pairs(col) do t.c[k]={cv[1] or 0,cv[2] or 0,cv[3] or 0,cv[4] or 1} end
    local ok,s=pcall(function() return hs:JSONEncode(t) end)
    if ok and type(s)=="string" and #s>0 then data=s end
  end
  if not data then
    local o={"#ego-config-v1"}
    for k,v in pairs(cfg) do
      if k~="cfg_slot" then o[#o+1]="v "..k.."="..(type(v)=="boolean" and (v and "1" or "0") or tostring(v)) end
    end
    for k,v in pairs(bind) do o[#o+1]="b "..k.."="..tostring(v) end
    for k,cv in pairs(col) do o[#o+1]="c "..k.."="..(cv[1] or 0)..","..(cv[2] or 0)..","..(cv[3] or 0)..","..(cv[4] or 1) end
    data=table.concat(o,"\n")
  end
  local g=cfg_env()
  if g then g.EGO_CFGS[slot]=data; g.EGO_SLOT=slot end
  local disk=false
  local ok,f=pcall(function() return io.open("ego_config_"..slot..".cfg","w") end)
  if ok and f then
    local wok=pcall(function() f:write(data) end)
    pcall(function() f:close() end)
    disk=wok
  end
  cfg_dirty=false
  cfg_last_save=utility.GetTime and utility.GetTime() or 0
  if not quiet then
    if disk then pcall(function() notify.Success("Config saved","slot "..slot.." - ego_config_"..slot..".cfg",3) end)
    else pcall(function() notify.Warning("Config saved to session","io.open is blocked, no file written",4) end) end
  end
  return disk
end
cfg_load=function(slot,quiet)
  slot=tonumber(slot) or tonumber(cfg.cfg_slot) or 1
  local g=cfg_env()
  local data=nil
  local ok,f=pcall(function() return io.open("ego_config_"..slot..".cfg","r") end)
  if ok and f then
    local rok,s=pcall(function() return f:read("*a") end)
    pcall(function() f:close() end)
    if rok and type(s)=="string" and #s>0 then data=s end
  end
  if not data and g and type(g.EGO_CFGS)=="table" then data=g.EGO_CFGS[slot] end
  if not data then
    if not quiet then pcall(function() notify.Warning("Nothing to load","slot "..slot.." is empty",3) end) end
    return false
  end
  local applied=false
  if data:sub(1,1)=="{" then
    local hs=cfg_http()
    if hs then
      local jok,t=pcall(function() return hs:JSONDecode(data) end)
      if jok and type(t)=="table" then
        for k,v in pairs(t.v or {}) do
          if cfg[k]~=nil then
            if type(v)=="boolean" then cfg[k]=v
            else local x=tonumber(v); if x then cfg[k]=x end end
          end
        end
        for k,v in pairs(t.b or {}) do
          if bind[k]~=nil then local x=tonumber(v); if x then bind[k]=x end end
        end
        for k,v in pairs(t.c or {}) do
          if col[k]~=nil and type(v)=="table" then
            local r1,g1,b1=tonumber(v[1]),tonumber(v[2]),tonumber(v[3])
            if r1 and g1 and b1 then col[k]={r1,g1,b1,tonumber(v[4]) or 1} end
          end
        end
        applied=true
      end
    end
  else
    for line in data:gmatch("[^\n]+") do
      local kind,k,val=line:match("^(%a) ([^=]+)=(.*)$")
      if kind then
        if kind=="v" and cfg[k]~=nil then
          if type(cfg[k])=="boolean" then cfg[k]=(val=="1" or val=="true")
          else local x=tonumber(val); if x then cfg[k]=x end end
        elseif kind=="b" and bind[k]~=nil then
          local x=tonumber(val); if x then bind[k]=x end
        elseif kind=="c" and col[k]~=nil then
          local r,g,b,a=val:match("([%d%.%-]+),([%d%.%-]+),([%d%.%-]+),([%d%.%-]+)")
          if r then col[k]={tonumber(r),tonumber(g),tonumber(b),tonumber(a) or 1} end
        end
      end
    end
    applied=true
  end
  if g then g.EGO_SLOT=slot end
  cfg_dirty=false
  if not quiet then
    if applied then pcall(function() notify.Success("Config loaded","slot "..slot,3) end)
    else pcall(function() notify.Error("Config is corrupted","slot "..slot.." could not be parsed",3) end) end
  end
  return applied
end
local function cfg_reset()
  -- re-apply the schema defaults, same loop the menu uses to seed the values
  for _,tab in ipairs(SCHEMA) do for _,g in ipairs(tab.groups) do for _,it in ipairs(g.items) do
    if it.t=="toggle" then cfg[it.id]=it.default or false
    elseif it.t=="slider" then cfg[it.id]=it.default or it.min
    elseif it.t=="combo" then cfg[it.id]=it.default or 1
    elseif it.t=="bind" then bind[it.id]=it.default or 0
    elseif it.t=="color" then col[it.id]={DEF_COL[it.id][1],DEF_COL[it.id][2],DEF_COL[it.id][3],DEF_COL[it.id][4]} end
  end end end
  cfg_dirty=true
  pcall(function() notify.Success("Defaults restored","",3) end)
end

getgenv().EGO_ID=(getgenv().EGO_ID or 0)+1
local MY_ID=getgenv().EGO_ID
local unloaded=false
for _,tab in ipairs(SCHEMA) do for _,g in ipairs(tab.groups) do for _,it in ipairs(g.items) do
  if it.id=="unload" then it._cb=function() cfg_save(cfg.cfg_slot,true); unloaded=true
    silent_release(); if R_disable then pcall(R_disable) end
    pcall(function() notify.Success("Ego","Unloaded",2) end) end
  elseif it.id=="cfg_save" then it._cb=function() cfg_save() end
  elseif it.id=="cfg_load" then it._cb=function() cfg_load() end
  elseif it.id=="cfg_reset" then it._cb=function() cfg_reset() end
  end
end end end

-- restore the last profile on start so the menu comes up the way it was left
cfg_env()
cfg.cfg_slot=tonumber(cfg_env().EGO_SLOT) or tonumber(cfg.cfg_slot) or 1
cfg_load(cfg.cfg_slot,true)

function OnFrame()
  if unloaded or getgenv().EGO_ID~=MY_ID then return end
  AC.frame=AC.frame+1
  _dt=utility.GetDeltaTime and utility.GetDeltaTime() or 0.016
  if not _dt or _dt<=0 or _dt>0.2 then _dt=0.016 end
  TUNE.cam=nil
  if cfg.accent_chroma then
    local h=now()*0.15
    theme.accent=hsv(h,0.7,1)
    theme.accent2=hsv(h+0.11,0.7,1)
  else
    theme.accent=col.c_accent or theme.accent
    theme.accent2=theme.accent2_base
  end
  update_input()
  pcall(scan_vm)
  pcall(scan_gadgets)
  pcall(run_aimbot)
  pcall(run_silent)
  pcall(run_trigger)
  pcall(run_esp)
  pcall(run_obj_esp)
  pcall(ND.run_nades)
  pcall(run_radar)
  pcall(run_alert)
  pcall(run_crosshair)
  pcall(run_hud)
  ui.appear=approach("appear", ui.open and 1 or 0, 14)
  if ui.appear>0.01 then pcall(draw_menu) end
  theme.opacity=1
  -- debounced autosave: any widget that touches a setting flags the profile
  -- dirty and it is written out at most once a second.
  if cfg_dirty and cfg.cfg_auto then
    local now=utility.GetTime and utility.GetTime() or 0
    if now-cfg_last_save>=1 then cfg_save(cfg.cfg_slot,true) end
  end
end

