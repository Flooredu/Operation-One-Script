local function update_input()
  ui.m.x,ui.m.y=mouse_pos()
  local d=ekey(0x01); ui.m.click=d and not ui.m.was; ui.m.down=d; ui.m.was=d
  if not d and ui.drag and ui.drag.k~="slider" then ui.drag=nil end
  if ui.drag and ui.drag.k=="win" then local sw,sh=scr(); ui.x=clamp(ui.m.x-ui.drag.ox,0,sw-ui.w); ui.y=clamp(ui.m.y-ui.drag.oy,0,sh-ui.h) end
  if ui.drag and ui.drag.k=="hud_keys" then hud_keys_pos.x=ui.m.x-ui.drag.ox; hud_keys_pos.y=ui.m.y-ui.drag.oy end
  if ui.drag and (ui.drag.k=="hud_mark" or ui.drag.k=="hud_bar") then
    local sw2,sh2=scr()
    local k=ui.drag.k=="hud_mark" and "mark" or "bar"
    hud_pos[k]={x=clamp(ui.m.x-ui.drag.ox,0,sw2-24),y=clamp(ui.m.y-ui.drag.oy,0,sh2-14)}
  end
  local mk=bind.menu_key or 0xA1; local held=ekey(mk)
  if held and not ui.menu_edge then ui.open=not ui.open; ui.picker=nil; ui.capture=nil end
  ui.menu_edge=held
  -- aimbot enable toggle. edge triggered, so holding the key flips it once
  -- instead of every frame. skipped while a bind is being captured: the
  -- capture loop reads every key on the keyboard and would otherwise bind the
  -- key AND flip the aimbot in the same frame.
  local tk=bind.aim_toggle or 0
  local th=(tk~=0) and ekey(tk) or false
  if th and not ui.tog_edge and not ui.capture then cfg.aim_on=not cfg.aim_on; cfg_dirty=true end
  ui.tog_edge=th
  -- silent aim and esp get the same edge triggered enable key. each toggle
  -- keeps its own edge flag, otherwise flipping one would leave the others
  -- latched and the next press would be swallowed.
  local sk=bind.silent_toggle or 0
  local sh=(sk~=0) and ekey(sk) or false
  if sh and not ui.tog_edge_s and not ui.capture then cfg.silent_on=not cfg.silent_on; cfg_dirty=true end
  ui.tog_edge_s=sh
  local ek=bind.esp_toggle or 0
  local eh=(ek~=0) and ekey(ek) or false
  if eh and not ui.tog_edge_e and not ui.capture then cfg.esp_on=not cfg.esp_on; cfg_dirty=true end
  ui.tog_edge_e=eh
  local qk=bind.trig_toggle or 0
  local qh=(qk~=0) and ekey(qk) or false
  if qh and not ui.tog_edge_t and not ui.capture then cfg.trig_on=not cfg.trig_on; cfg_dirty=true end
  ui.tog_edge_t=qh
  if ui.capture then
    if not ui.capture_ok then if not ekey(0x01) then ui.capture_ok=true end return end
    if ekey(0x1B) then bind[ui.capture]=0; cfg_dirty=true; ui.capture=nil; return end
    for vk=0x01,0xFE do if vk~=0x1B and ekey(vk) then bind[ui.capture]=vk; cfg_dirty=true; ui.capture=nil; return end end
  end
end

local BONE_LIST={"head","torso","arm1","arm2","leg1","leg2","shoulder1","shoulder2","hip1","hip2"}
local SKELETON={{"head","torso"},{"torso","shoulder1"},{"torso","shoulder2"},{"shoulder1","arm1"},{"shoulder2","arm2"},{"torso","hip1"},{"torso","hip2"},{"hip1","leg1"},{"hip2","leg2"}}
local AIM_BONE={"head","torso","hip1","arm1","leg1","head"}
local vm_players={}
local gadget_cache={}
local vm_seen={}
local char_models={}
local char_last=-1
local MATCH_R2=400
local MAXD2=250000
local HIDE2=9
local GRACE=0.4
-- a viewmodel record is dropped this long after it was last seen. it has to sit
-- comfortably beyond GRACE - the window a stale viewmodel keeps being drawn
-- for - or the pruner would evict a live player before the grace check could
-- ever fire.
local VM_STALE=2.0

-- closure-free accessors.
--
-- scan_vm runs every frame over every viewmodel, and the obvious
-- `pcall(function() return vm:FindFirstChild(bn) end)` form allocates a fresh
-- closure for EVERY bone, EVERY viewmodel, EVERY frame. at 10 bones and a full
-- lobby that is thousands of short-lived closures per tick - pure GC pressure,
-- and it scales with player count, which is exactly the shape of a progressive
-- framerate slide. handing pcall the function and its arguments instead
-- allocates nothing.
--
-- they live in one table rather than as separate locals because the main chunk is
-- already against Lua's 200-local limit (see the TUNE note).
local AC={}
-- bumped once per rendered frame by OnFrame. AC.proj stamps its per-bone memo
-- with it, so a memo is never reused across frames.
AC.frame=0
function AC.child(inst,name) return inst:FindFirstChild(name) end
function AC.pos(inst) return inst.Position end
function AC.size(inst) return inst.Size end
function AC.trans(inst) return inst.Transparency end
function AC.name(inst) return inst.Name end
function AC.addr(inst) return inst.Address end
function AC.campos() return camera.GetPosition() end
function AC.hp(h) return h.Health end
function AC.maxhp(h) return h.MaxHealth end
function AC.tool(m) return m:FindFirstChildOfClass("Tool") end
-- write a bone position into a reusable slot. nil means the bone is genuinely
-- absent, and the slot is cleared so aim_src can still tell "no real bone
-- here" from "not filled in yet".
function AC.bone(slot,inst)
  if not inst then return nil end
  local p=call(AC.pos,inst)
  if not p then return nil end
  if not slot then slot={} end
  slot.x=p.X; slot.y=p.Y; slot.z=p.Z
  return slot
end
-- project a bone ONCE per frame and remember the result on the bone itself.
-- the bone tables are reused frame to frame, so the memo can never be stale -
-- which is what lets run_esp drop its per-player sx_cache table.
--
-- the memo is stamped with the frame id rather than reset by scan_vm. scan_vm is
-- pcall'd, so it can be skipped entirely if an engine read throws; with a reset
-- driven from scan_vm the stale projection would then survive into the next
-- frame and the ESP would draw from last frame's coordinates.
function AC.proj(b)
  if b.fid~=AC.frame then
    local x,y,v=W2S(b.x,b.y,b.z)
    b.sx=x; b.sy=y; b.sv=v; b.fid=AC.frame
  end
  return b.sx,b.sy,b.sv
end

local function refresh_char_models()
  char_models={}
  local ws=game.Workspace; if not ws then return end
  for _,c in ipairs(call(function() return ws:GetChildren() end) or {}) do
    if c.ClassName=="Model" then
      local hrp=call(AC.child,c,"HumanoidRootPart")
      local hum=call(AC.child,c,"Humanoid")
      if not hum then hum=call(function() return c:FindFirstChildOfClass("Humanoid") end) end
      if hrp and hum then
        local cb={}
        for _,bn in ipairs({"head","torso","hip1","LowerTorso","UpperTorso"}) do
          local bp=call(AC.child,c,bn)
          if bp then cb[bn]=bp end
        end
        -- the address is cached here so the viewmodel -> character match can
        -- be held stable across refreshes. GetChildren hands back a fresh
        -- userdata wrapper for the same instance on every call, so the model
        -- itself is not a usable key - the address is.
        char_models[c]={hrp=hrp,hum=hum,bones=cb,addr=call(AC.addr,c)}
      end
    end
  end
end
-- refresh the cached world position of every character model.
--
-- this used to be read inside match_char, i.e. once per VIEWMODEL per model per
-- frame - V*C engine property reads per tick, where V is the viewmodel count
-- and C the character count. every viewmodel is matched against the SAME set
-- of character positions, so they are read once per tick here and the match
-- itself becomes pure arithmetic.
local function refresh_char_pos()
  for model,data in pairs(char_models) do
    local pos=call(AC.pos,data.hrp)
    if pos then data.px=pos.X; data.py=pos.Y; data.pz=pos.Z else data.px=nil end
  end
end
-- match a viewmodel to the character model it mirrors.
--
-- prev_addr is the address of the match used on the previous frame. the
-- nearest-model search flips between two players standing next to each other,
-- and every flip swaps their names, health and weapons - the classic ESP
-- flicker. the previous match is therefore kept as long as it is still
-- reasonably close, so the assignment only changes when it really has to.
local function match_char(hx,hy,hz,prev_addr)
  local best,bd=nil,MATCH_R2
  local pmodel,pdata=nil,nil
  for model,data in pairs(char_models) do
    local px=data.px
    if px then
      local dx,dy,dz=hx-px,hy-data.py,hz-data.pz; local d=dx*dx+dy*dy+dz*dz
      if d<bd then bd=d; best=model end
      if prev_addr and not pdata and d<MATCH_R2*2.25 and data.addr==prev_addr then pmodel=model; pdata=data end
    end
  end
  if pmodel then return pmodel end
  return best
end

local function scan_vm()
  -- the list is built into a local and swapped in at the very end. a read
  -- that throws half way through the sweep therefore leaves the PREVIOUS
  -- frame in place instead of blanking the whole ESP for one frame - the
  -- difference between a single dropped frame and the overlay strobing.
  local out={}
  local tnow=now()
  -- drop records whose viewmodel is long gone. without a prune the table only
  -- ever grows, and a table that never shrinks is what turns a 1000fps machine
  -- into a 300fps one a couple of minutes into a match.
  for k,r in pairs(vm_seen) do
    if not r.seen or (tnow-r.seen)>VM_STALE then vm_seen[k]=nil end
  end
  local ws=game.Workspace; local vf=ws and call(AC.child,ws,"Viewmodels")
  if not vf then vm_players={}; return end
  if tnow-char_last>0.3 then char_last=tnow; pcall(refresh_char_models) end
  refresh_char_pos()
  local cam=call(AC.campos)
  for _,vm in ipairs(call(function() return vf:GetChildren() end) or {}) do
    if vm.Name=="Viewmodel" then
      -- the record is keyed by the viewmodel's ADDRESS, never by the instance.
      --
      -- GetChildren hands back a fresh userdata wrapper for the same underlying
      -- instance on every call, so an instance-keyed table collects a NEW key
      -- every single frame for the same viewmodel and grows without bound. that
      -- is the same defect nade_parents had, and the same symptom: a steady
      -- slide from 1000fps to 300fps over the course of a match, with the ESP
      -- starting to twitch once the table got big enough to hurt.
      --
      -- Address is a stable integer for the lifetime of the instance, so every
      -- frame collapses onto the SAME record and the table stays proportional to
      -- the number of viewmodels that actually exist.
      local vkey=call(AC.addr,vm); if vkey==0 then vkey=nil end
      local rec
      if vkey then
        rec=vm_seen[vkey]
        if not rec then rec={}; vm_seen[vkey]=rec end
      else
        rec={}   -- no stable identity: this frame's record only, never cached
      end
      rec.seen=tnow
      local torso=call(AC.child,vm,"torso")
      local head=call(AC.child,vm,"head")
      if torso and head then
        local tp=call(AC.pos,torso); local tsz=call(AC.size,torso); local ttr=call(AC.trans,torso) or 0
        if tp and tsz and tsz.X>0.1 and tsz.Y>0.1 and ttr<1 then
          local hpos=call(AC.pos,head)
          local dcam=(cam and hpos) and ((cam.X-hpos.X)^2+(cam.Y-hpos.Y)^2+(cam.Z-hpos.Z)^2) or 0
          if (not cam) or (dcam<=MAXD2 and dcam>HIDE2) then
            -- the bone tables live on the record and are reused frame to frame.
            -- rebuilding them per viewmodel per frame was ~11 short-lived tables
            -- per player per frame, and that GC pressure scales with the size of
            -- the lobby.
            local bones=rec.bones
            if not bones then bones={}; rec.bones=bones end
            local bvs=rec.bv
            if not bvs then bvs={}; rec.bv=bvs end
            local mnx,mny,mnz,mxx,mxy,mxz=1e9,1e9,1e9,-1e9,-1e9,-1e9; local bc=0
            for i=1,#BONE_LIST do
              local bn=BONE_LIST[i]
              local b=call(AC.child,vm,bn)
              local p,sz
              if b then p=call(AC.pos,b); sz=call(AC.size,b) end
              if p and sz and sz.X>0 then
                local v=bvs[i]
                if not v then v={}; bvs[i]=v end
                v.x=p.X; v.y=p.Y; v.z=p.Z
                bones[bn]=v; bc=bc+1
                local hx,hy,hz=sz.X*0.5,sz.Y*0.5,sz.Z*0.5
                if p.X-hx<mnx then mnx=p.X-hx end; if p.Y-hy<mny then mny=p.Y-hy end; if p.Z-hz<mnz then mnz=p.Z-hz end
                if p.X+hx>mxx then mxx=p.X+hx end; if p.Y+hy>mxy then mxy=p.Y+hy end; if p.Z+hz>mxz then mxz=p.Z+hz end
              else
                bones[bn]=nil
              end
            end
            if bc>=5 then
              local hx,hy,hz
              if bones.head then hx,hy,hz=bones.head.x,bones.head.y,bones.head.z else hx,hy,hz=tp.X,tp.Y,tp.Z end
              local model=match_char(hx,hy,hz,rec.addr)
              if model then
                local data=char_models[model]
                rec.addr=data.addr
                local hp,mhp=100,100
                local ok1,v1=pcall(AC.hp,data.hum)
                if ok1 then hp=tonumber(v1) or 0 end
                local ok2,v2=pcall(AC.maxhp,data.hum)
                if ok2 then mhp=tonumber(v2) or 100 end
                if mhp<1 then mhp=100 end
                if hp>0 then
                  rec.alive=true; rec.dc=0
                  rec.t=tnow; rec.hp=hp; rec.mhp=mhp; rec.ent=data.hrp
                  -- lock the label to the player it was first matched with. the
                  -- nearest-model search can flip between two nearby characters
                  -- for a frame, and blindly copying the new name every frame
                  -- made the ESP labels swap from player to player. a different
                  -- name on a different match address must stay put for a full
                  -- second before it is accepted, so momentary flips are ignored
                  -- while a real respawn/reassignment still updates.
                  local nm=call(AC.name,model)
                  if nm then
                    if not rec.name then
                      rec.name=nm; rec.nameaddr=rec.addr
                    elseif nm~=rec.name then
                      if rec.nameaddr==rec.addr then
                        rec.name=nm; rec.nameaddr=rec.addr; rec.caddr=nil; rec.cname=nil
                      elseif rec.caddr~=rec.addr or rec.cname~=nm then
                        rec.caddr=rec.addr; rec.cname=nm; rec.ct=tnow
                      elseif tnow-(rec.ct or 0)>=1.0 then
                        rec.name=nm; rec.nameaddr=rec.addr; rec.caddr=nil; rec.cname=nil
                      end
                    else
                      rec.caddr=nil; rec.cname=nil
                    end
                  end
                  -- aim bones, taken from the REAL character model rather than the viewmodel.
                  -- aim_src() falls back to p.bones (the viewmodel) when a name is
                  -- absent here, and the viewmodel is parked next to the camera -
                  -- so a fallback bone projects nearest the crosshair every time
                  -- and "Closest" would always pick it. that is exactly the bug
                  -- where Closest aimed at the closest-by-distance part instead of
                  -- the closest-to-crosshair part.
                  --
                  -- R6 has torso/hip1; R15 has UpperTorso/LowerTorso and no torso
                  -- or hip1 at all, so the aliases below are what keep R15 players
                  -- from silently dropping to viewmodel bones. all three keys are
                  -- always written, even when the fallback is nil, so aim_src can
                  -- detect "no real bone" instead of quietly using the viewmodel.
                  local bd=data.bones
                  local ab=rec.ab
                  if not ab then ab={}; rec.ab=ab end
                  ab.head=AC.bone(ab.head,bd and bd.head)
                  ab.torso=AC.bone(ab.torso,(bd and bd.torso) or (bd and bd.UpperTorso) or (bd and bd.LowerTorso))
                  ab.hip1=AC.bone(ab.hip1,(bd and bd.hip1) or (bd and bd.LowerTorso) or (bd and bd.UpperTorso))
                  local tool=call(AC.tool,model)
                  rec.tool=tool and call(AC.name,tool) or nil
                else
                  -- confirmed dead. the record stays (so the scratch tables are
                  -- still reused) but the player leaves the ESP immediately,
                  -- exactly as it did when the grace check was a no-op.
                  --
                  -- one dead frame is not enough to drop them though: the
                  -- humanoid is swapped out for a frame during a death or a
                  -- respawn, and taking the player off the ESP for that single
                  -- frame is a visible blink. two dead reads in a row are
                  -- required instead.
                  rec.dc=(rec.dc or 0)+1
                  if rec.dc>=2 then rec.alive=false end
                end
              end
              if rec.alive and rec.t and (tnow-rec.t)<=GRACE then
                local friend=false
                if call(AC.child,head,"Username") or call(AC.child,vm,"TeammateHighlight") or call(AC.child,head,"TeammateHighlight") then friend=true end
                local e=rec.e
                if not e then e={}; rec.e=e end
                local aabb=e.aabb
                if not aabb then aabb={}; e.aabb=aabb end
                aabb[1]=mnx; aabb[2]=mny; aabb[3]=mnz; aabb[4]=mxx; aabb[5]=mxy; aabb[6]=mxz
                e.bones=bones; e.ab=rec.ab
                e.hp=rec.hp or 100; e.mhp=rec.mhp or 100; e.name=rec.name; e.ent=rec.ent; e.tool=rec.tool; e.friend=friend
                out[#out+1]=e
              end
            end
          end
        end
      end
    end
  end
  -- swap the finished list in. anything that threw above left the old list
  -- untouched, so one bad read cannot clear the overlay.
  vm_players=out
end
-- screen bounds of the world-space AABB. the corner list used to be rebuilt as
-- a table of nine tables on every call, i.e. once per player per frame; the
-- eight corners are unrolled instead so a player costs nothing but the eight
-- projections themselves.
local function box2d(bb)
  local x0,y0,z0=bb[1],bb[2],bb[3]
  local x1,y1,z1=bb[4],bb[5],bb[6]
  local mnx,mny,mxx,mxy,vis=1e9,1e9,-1e9,-1e9,false
  local sx,sy,v
  sx,sy,v=W2S(x0,y0,z0); if v then vis=true; mnx=sx; mny=sy; mxx=sx; mxy=sy end
  sx,sy,v=W2S(x1,y0,z0); if v then vis=true; if sx<mnx then mnx=sx end; if sy<mny then mny=sy end; if sx>mxx then mxx=sx end; if sy>mxy then mxy=sy end end
  sx,sy,v=W2S(x0,y1,z0); if v then vis=true; if sx<mnx then mnx=sx end; if sy<mny then mny=sy end; if sx>mxx then mxx=sx end; if sy>mxy then mxy=sy end end
  sx,sy,v=W2S(x1,y1,z0); if v then vis=true; if sx<mnx then mnx=sx end; if sy<mny then mny=sy end; if sx>mxx then mxx=sx end; if sy>mxy then mxy=sy end end
  sx,sy,v=W2S(x0,y0,z1); if v then vis=true; if sx<mnx then mnx=sx end; if sy<mny then mny=sy end; if sx>mxx then mxx=sx end; if sy>mxy then mxy=sy end end
  sx,sy,v=W2S(x1,y0,z1); if v then vis=true; if sx<mnx then mnx=sx end; if sy<mny then mny=sy end; if sx>mxx then mxx=sx end; if sy>mxy then mxy=sy end end
  sx,sy,v=W2S(x0,y1,z1); if v then vis=true; if sx<mnx then mnx=sx end; if sy<mny then mny=sy end; if sx>mxx then mxx=sx end; if sy>mxy then mxy=sy end end
  sx,sy,v=W2S(x1,y1,z1); if v then vis=true; if sx<mnx then mnx=sx end; if sy<mny then mny=sy end; if sx>mxx then mxx=sx end; if sy>mxy then mxy=sy end end
  if not vis then return nil end
  return mnx,mny,mxx,mxy
end
-- camera position, cached per frame. camera.GetPosition() is an engine call and
-- cam_dist is hit once per player, once per objective and once per grenade every
-- frame, so the uncached version made a few hundred redundant engine round-trips
-- per tick. OnFrame clears this once, so the value is always at most one frame old
-- - the same staleness the previous code had by accident anyway, since every
-- caller resolved it mid-frame.
-- tunables + per-frame camera cache.
--
-- these live in a table rather than as separate `local`s because the main chunk is
-- against Lua's hard 200-local limit ("main function has more than 200 local
-- variables" at load). every top-level local costs a slot whether or not it is
-- used, so these are grouped: 1 local here instead of 6.
local TUNE={ bone_switch=14, esp_alpha_floor=0.25, obj_alpha_floor=0.25 }
local function frame_cam()
  if TUNE.cam then return TUNE.cam end
  local c=call(function() return camera.GetPosition() end)
  TUNE.cam=c
  if not c then TUNE.cam2=0 else local x,y,z=c.X,c.Y,c.Z; TUNE.cam2=x*x+y*y+z*z end
  return TUNE.cam
end
local function cam_dist(x,y,z) local cam=frame_cam(); if not cam then return 0 end return math.sqrt(TUNE.cam2-2*(cam.X*x+cam.Y*y+cam.Z*z)+(x*x+y*y+z*z)) end
local function offscreen_dir(wx,wy,wz)
  local cam=camera.GetPosition(); local look=camera.GetLookVector(); if not cam or not look then return nil end
  local dx,dy,dz=wx-cam.X,wy-cam.Y,wz-cam.Z
  local rx,ry,rz=-look.Z,0,look.X; local rl=math.sqrt(rx*rx+rz*rz); if rl<1e-6 then rl=1e-6 end rx,rz=rx/rl,rz/rl
  local ux=ry*look.Z-rz*look.Y; local uy=rz*look.X-rx*look.Z; local uz=rx*look.Y-ry*look.X
  local sxp=dx*rx+dy*ry+dz*rz; local syp=dx*ux+dy*uy+dz*uz
  return ATAN2(-syp,sxp)
end

-- aim_target is NOT a sticky lock: it only records who we are currently on so a
-- swap can be detected, which re-arms the deadzone. acquisition itself is a
-- fresh score comparison every frame.
local aim_target=nil
local aim_bone_lock=nil
local aim_dz_state=0
local aim_rx=0
local aim_ry=0

-- Smoothing is a straight divisor on the screen-space error, the same shape
-- Project Vector uses: move a 1/sm fraction of what is left, every frame.
-- sm=1 is a hard snap. no state, no velocity, no spring - the response is
-- purely a function of the current error, so it cannot overshoot and cannot
-- carry a flick across a target swap.
local function aim_step(ex,ey,sm)
  if sm<=1 then return ex,ey end
  return ex/sm, ey/sm
end

-- MoveMouse truncates sub-pixel deltas, so carry the remainder. without this
-- the last pixel or two of convergence is silently dropped every frame and
-- the aim parks a pixel or two off forever.
local function aim_emit(fx,fy)
  aim_rx=aim_rx+fx
  aim_ry=aim_ry+fy
  local ix=(aim_rx>=0) and math.floor(aim_rx+0.5) or -math.floor(0.5-aim_rx)
  local iy=(aim_ry>=0) and math.floor(aim_ry+0.5) or -math.floor(0.5-aim_ry)
  if ix==0 and iy==0 then return end
  aim_rx=aim_rx-ix
  aim_ry=aim_ry-iy
  pcall(input.MoveMouse,ix,iy)
end

local function aim_reset()
  aim_target=nil
  aim_bone_lock=nil
  aim_dz_state=0
  aim_rx=0
  aim_ry=0
end

-- prefer the real character bone over the viewmodel bone. viewmodels render
-- under a different view matrix in most shooters, so projecting their parts
-- through the camera matrix lands off-target.
-- aim bone source. p.ab is the real character rig (with R15 aliases already
-- resolved in scan_vm); p.bones is the viewmodel.
--
-- the fallback to p.bones is NOT safe for aiming. the viewmodel sits next to the
-- camera, so its bones project closest to the crosshair of anything on screen,
-- and "Closest" would beat a real head every single time. it is kept only as a
-- last resort for when ab is entirely absent (no matched character model at all),
-- which is better than having no candidate. a real bone, when present, always wins.
-- how many pixels closer another bone must be before Closest switches to it.
-- this is jitter insurance, not a lock: the incumbent bone keeps a 14px handicap,
-- so bones that are effectively tied on screen will not flip frame to frame, but a
-- bone the crosshair is genuinely resting on still wins immediately.
local function aim_src(p,bn)
  local ab=p.ab
  if ab then
    local v=ab[bn]
    if v then return v end
    -- ab is populated but this bone is genuinely absent (R15 with no matching
    -- UpperTorso/LowerTorso). do NOT fall back to the viewmodel - return nil so
    -- the bone is skipped and Closest picks from the real bones that do exist.
    if next(ab)~=nil then return nil end
  end
  return p.bones and p.bones[bn]
end

-- FOV style. the SHAPE decides both the hit region and the drawn indicator, so
-- the circle/box you see is exactly the region that gets tested - there is no
-- cosmetic-only mismatch where the visible shape lies about the real bounds.
--   1 Circle     radial, d <= fov. this is the original behaviour and stays the
--                default so existing configs do not change hands.
--   2 Box        half-extent fov on both axes.
--   3 Diamond    rotated square, |dx|+|dy| <= fov. the corners reach further out
--                than the box at the same fov while the edges sit closer in.
--   4 Corner Box same region as Box, drawn as corner brackets. visual only -
--                identical acquisition to style 2, pick it for the look.
-- the slider is the style's own single scale parameter: radius for circle, half
-- width/height for box and diamond.
local function fov_inside(style,f,sx,sy,cx,cy)
  if not sx or not sy then return false end
  local dx=sx-cx; local dy=sy-cy
  local ax=dx<0 and -dx or dx; local ay=dy<0 and -dy or dy
  if style==2 or style==4 then return ax<=f and ay<=f end
  if style==3 then return ax+ay<=f end
  return dx*dx+dy*dy<=f*f
end
-- both box styles share one centred region: half-extent fov on each axis.
local function fov_box(f,cx,cy) return cx-f,cy-f,f*2,f*2 end
-- point list for the fov ring, cached per radius.
--
-- the api's outlined circle (draw.Circle) draws shadow rings on BOTH sides of
-- the line - that is what made the old fov read as a fuzzy triple ring instead
-- of a clean outline. the circle is a closed polyline now: one 1px stroke, no
-- side rings, no glow. the point count scales with the radius so the outline
-- follows the true circle instead of a visible polygon.
--
-- the list is rebuilt only when the radius actually changes (the slider), not
-- every frame, so the ring costs one native call per frame.
local fov_cache={}
local function fov_circle_pts(cx,cy,f)
  local k=math.floor(f*2+0.5)
  local e=fov_cache[k]
  if e and e.cx==cx and e.cy==cy then return e.pts end
  local n=math.floor(math.pi*f)
  if n<96 then n=96 elseif n>360 then n=360 end
  local pts={}
  for i=0,n-1 do local t=i/n*math.pi*2; pts[i+1]={cx+math.cos(t)*f,cy+math.sin(t)*f} end
  local cnt=0; for _ in pairs(fov_cache) do cnt=cnt+1 end
  if cnt>16 then fov_cache={} end
  fov_cache[k]={cx=cx,cy=cy,pts=pts}
  return pts
end
-- the fov indicator is the fov and nothing else: one clean shape, no glow,
-- no second outline, no shadow rings.
local function fov_draw(style,f,cx,cy,c,al)
  local q={c[1],c[2],c[3],al}
  if style==2 then
    local x,y,w,h=fov_box(f,cx,cy)
    pcall(draw.Rect,x,y,w,h,q,0,1)
  elseif style==4 then
    local x,y,w,h=fov_box(f,cx,cy)
    pcall(draw.CornerBox,x,y,w,h,q)
  elseif style==3 then
    pcall(draw.PolyClosed,{{cx,cy-f},{cx+f,cy},{cx,cy+f},{cx-f,cy}},q,1)
  else
    local pts=fov_circle_pts(cx,cy,f)
    if draw.PolyClosed then pcall(draw.PolyClosed,pts,q,1)
    else pcall(draw.Circle,cx,cy,f,q,360,1) end
  end
end

local function run_aimbot()
  if not cfg.aim_on then aim_reset(); return end
  local sw,sh=scr(); local cx,cy=sw*0.5,sh*0.5
  if cfg.aim_fovcircle then fov_draw(cfg.aim_fovstyle,cfg.aim_fov,cx,cy,cfg.aim_fovchroma and chroma() or col.c_fov,0.8) end
  -- the target line is a live readout, so target selection runs whether or not
  -- the key is down. only the mouse move is gated on the key.
  local firing=ekey(bind.aim_key or 0x02)
  local function cand_for(p)
    if cfg.aim_team and p.friend then return nil end
    if cfg.aim_bone==6 then
      -- Closest genuinely re-scores every bone every frame - that is the whole
      -- point of the option. an earlier version hard-locked the first bone picked
      -- at acquisition (order={lock}) to stop the aim point flickering, which meant
      -- Closest stopped being a comparison at all and just aimed wherever the
      -- crosshair happened to be when the target engaged. if the crosshair later
      -- settled on the head, it kept aiming at the torso.
      --
      -- jitter is handled with hysteresis instead of a lock: a new bone has to beat
      -- the incumbent by TUNE.bone_switch px before it takes over. 14px is roughly
      -- one text line, so a bone that is merely a hair closer will not steal the
      -- lock, but a clearly closer one will. result is still "closest to
      -- crosshair", just not twitching between two bones a pixel apart.
      local order={"head","torso","hip1","arm1","arm2","leg1","leg2"}
      local c,md=nil,1e9
      local locked=aim_bone_lock
      if locked and (p.name or p.key)~=aim_target then locked=nil end
      for _,bn in ipairs(order) do
        local b=aim_src(p,bn)
        if b then
          local sx,sy,v=W2S(b.x,b.y,b.z)
          if v then
            local d2=(sx-cx)*(sx-cx)+(sy-cy)*(sy-cy)
            -- incumbent gets a handicap so it only loses to a clearly better bone
            local eff=(bn==locked) and math.sqrt(d2)-TUNE.bone_switch or math.sqrt(d2)
            if eff<md then md=eff; c={sx=sx,sy=sy,b=b,p=p,bn=bn,d=math.sqrt(d2)} end
          end
        end
      end
      return c
    end
    -- "Arms"/"Legs" aim at whichever limb on that pair is nearer the crosshair and
    -- re-pick every frame, so aiming at one and drifting onto the other follows.
    -- both limbs are scored; same bone_switch hysteresis as Closest keeps the pick
    -- from flicking between two limbs that are a pixel apart.
    if cfg.aim_bone==4 or cfg.aim_bone==5 then
      local order=(cfg.aim_bone==4) and {"arm1","arm2"} or {"leg1","leg2"}
      local c,md=nil,1e9
      local locked=aim_bone_lock
      if locked and (p.name or p.key)~=aim_target then locked=nil end
      for _,bn in ipairs(order) do
        local b=aim_src(p,bn)
        if b then
          local sx,sy,v=W2S(b.x,b.y,b.z)
          if v then
            local d2=(sx-cx)*(sx-cx)+(sy-cy)*(sy-cy)
            local eff=(bn==locked) and math.sqrt(d2)-TUNE.bone_switch or math.sqrt(d2)
            if eff<md then md=eff; c={sx=sx,sy=sy,b=b,p=p,bn=bn,d=math.sqrt(d2)} end
          end
        end
      end
      return c
    end
    local bn=AIM_BONE[cfg.aim_bone] or "head"
    local b=aim_src(p,bn)
    if b then local sx,sy,v=W2S(b.x,b.y,b.z)
      if v then return {sx=sx,sy=sy,b=b,p=p,bn=bn,d=math.sqrt((sx-cx)*(sx-cx)+(sy-cy)*(sy-cy))} end
    end
    return nil
  end
  local function score(c)
    local m=cfg.aim_priority or 1
    if m==2 then return cam_dist(c.b.x,c.b.y,c.b.z)
    elseif m==3 then return (c.p.hp or 100)*1e4 + c.d
    else return c.d end
  end
  -- wall check. the visibility cache is only meaningful once it reports ready;
  -- while it is still warming up the test is skipped rather than guessed, so
  -- enabling the option cannot blank the aimbot for the first second of a round.
  -- the ray is cast from the camera to the exact bone that would be aimed at, so
  -- a head peeking over cover is visible while a torso behind it is not.
  local wall_ready=false
  if cfg.aim_wall then
    if raycast and raycast.IsReady then pcall(function() wall_ready=raycast.IsReady() end) end
  end
  local function seen(c)
    if not cfg.aim_wall or not wall_ready then return true end
    local cam=frame_cam()
    if not cam then return true end
    local ok,vis=pcall(raycast.IsVisible,cam.X,cam.Y,cam.Z,c.b.x,c.b.y,c.b.z)
    return not (ok and vis==false)
  end
  -- strict FOV re-test for the override, deliberately stricter than the pool gate.
  --
  -- fov_inside tests a SQUARE of half-extent f for Box/Corner Box, so a point in
  -- the corner is up to f*1.41 from centre - visually outside the circle the
  -- player believes they have, yet inside the tested region. a gadget never hit
  -- this because it is only ever taken when nothing better exists, whereas
  -- playerover actively promotes a marginal player over a solidly-in-FOV gadget.
  -- so the override requires the player's HEAD - not just the chosen bone - to
  -- sit inside the same region the target line is drawn against. head rather than
  -- the bone, because the bone can be a hip that swings far outside while the
  -- player still reads as on-screen.
  local function fov_head_ok(p,style,f,cx2,cy2)
    local hb=p.bones.head or p.bones.torso
    if not hb then return false end
    local sx,sy,v=W2S(hb.x,hb.y,hb.z)
    if not v then return false end
    return fov_inside(style,f,sx,sy,cx2,cy2)
  end

  local best,bs=nil,1e18
  for _,p in ipairs(vm_players) do
    local c=cand_for(p)
    if c and fov_inside(cfg.aim_fovstyle,cfg.aim_fov,c.sx,c.sy,cx,cy) then local s=score(c); if s<bs and seen(c) then bs=s; best=c end end
  end
  if cfg.aim_drone then
    local gb,gs=nil,1e18
    for _,d in ipairs(gadget_cache) do
      local sx,sy,v=W2S(d.x,d.y,d.z)
      if v then local dd=math.sqrt((sx-cx)*(sx-cx)+(sy-cy)*(sy-cy))
        if fov_inside(cfg.aim_fovstyle,cfg.aim_fov,sx,sy,cx,cy) then local c={sx=sx,sy=sy,b=d,p={name=d.lb,key=d.lb,hp=100},bn="gadget",d=dd}; local s=score(c); if s<gs and seen(c) then gs=s; gb=c end end
      end
    end
    -- a gadget is only taken when there is no player to take, or when the
    -- override is off. with the override on, the player also has to pass the
    -- stricter head-inside-FOV test - otherwise playerover could promote a
    -- player who is only marginally inside the (square, for box styles) FOV
    -- region over a gadget sitting dead centre.
    if gb then
      local use=not best
      if not use and cfg.aim_playerover then use=not fov_head_ok(best.p,cfg.aim_fovstyle,cfg.aim_fov,cx,cy) end
      if use then best=gb end
    end
  end
  if not best then
    aim_reset()
    return
  end
  local prev_target=aim_target
  aim_target=best.p.name or best.p.key
  -- priority can still hand us a different player when someone crosses the
  -- crosshair; a swap re-arms the deadzone so the new target is not already
  -- considered arrived-at, and drops the Closest-bone lock so the new player
  -- gets its own bone picked.
  if prev_target~=aim_target then aim_dz_state=0; aim_bone_lock=nil end
  if (cfg.aim_bone==6 or cfg.aim_bone==4 or cfg.aim_bone==5) and best.bn~="gadget" then aim_bone_lock=best.bn end
  -- target line. visible whenever a target is acquired, key held or not - the
  -- toggle is a pure visibility control, it is not tied to firing. plain line
  -- from the crosshair to the target, no endpoint marker, own color.
  if cfg.aim_tline then
    draw.Line(cx,cy,best.sx,best.sy, a(col.c_tline,1), 1)
  end
  if not firing then
    -- keep the lock and the line up, but re-arm so the next flick converges
    -- from scratch.
    aim_dz_state=0
    return
  end
  local sm=math.max(1,math.floor(cfg.aim_smooth or 1))
  local aimx,aimy=best.sx,best.sy
  local dx,dy=aimx-cx,aimy-cy
  local dist=math.sqrt(dx*dx+dy*dy)
  -- stop inside the deadzone, re-arm only once well clear of it. never scale
  -- the step by dz/dist - that makes the aim crawl at the edge, never settle.
  local zs=cfg.aim_dz or 0
  local zstart=zs*2.2
  if aim_dz_state==1 then
    if dist>zstart then aim_dz_state=0 end
  else
    if dist<=zs then
      -- latched. no velocity to kill any more, just stop feeding it.
      aim_dz_state=1
    end
  end
  if aim_dz_state==0 then
    local sx,sy=aim_step(dx,dy,sm)
    if sx~=0 or sy~=0 then aim_emit(sx,sy) end
  end
end

local function shoot_origin()
  local o; local lp=entity.GetLocalPlayer()
  if lp then pcall(function() o=lp.HeadPosition end) end
  if not o then pcall(function() o=camera.GetPosition() end) end
  return o
end

-- lowest slider value that still reads as "faded" rather than "black". at or
-- below this the ESP is skipped entirely (see run_esp). 0.25 keeps the colored
-- fill strong enough to out-weigh the unavoidable black shadow pass.
local function run_esp()
  if not cfg.esp_on then return end
  local sw,sh=scr(); local cx,cy=sw*0.5,sh*0.5; local tsz=cfg.esp_textsize
  -- player ESP opacity, 0..1, applied as a multiplier on every alpha in this
  -- function rather than folded into the color helper. a() already multiplies
  -- by theme.opacity, so the slider composes with that instead of replacing it.
  --
  -- the floor is NOT arbitrary. every draw primitive in this API auto-includes a
  -- shadow pass ("All primitives automatically include a shadow pass", and
  -- draw.Text adds a 4-direction *black* outline) whose alpha the color table
  -- does not control. fading the fill alone therefore leaves a full-strength
  -- black ghost behind it - low values render as black text, not absent text.
  -- the slider therefore starts AT the floor rather than going below it, so there
  -- is no dead band to fall into. the guard is strict `<` for the same reason:
  -- with min=25, `<=` would hide the ESP at exactly its lowest setting.
  local op=clamp((cfg.esp_alpha or 100)/100,0,1)
  if op<TUNE.esp_alpha_floor then return end
  for _,p in ipairs(vm_players) do
    local head=p.bones.head
    local dist=head and cam_dist(head.x,head.y,head.z) or 0
    if (cfg.esp_maxdist>=3000 or dist<=cfg.esp_maxdist) and (cfg.esp_team or not p.friend) then
      local base=col.c_enemy
      if cfg.esp_chroma then base=chroma() end
      -- china hat apex in screen space. the name has to clear it, otherwise the
      -- text sits right on the apex and hides the hat, so the apex is
      -- projected once here and reused by the hat drawing further down.
      local hat_s=1; local hat_x,hat_y,hat_v=0,0,false
      if cfg.esp_hat and head then
        hat_s=(cfg.esp_hat_size or 100)/100
        local hx,hy,hv=W2S(head.x,head.y+1.16*hat_s,head.z)
        hat_x,hat_y,hat_v=hx,hy,hv
      end
      local mnx,mny,mxx,mxy=box2d(p.aabb)
      if mnx then
        local bx,by,bw,bh=mnx-3,mny-3,(mxx-mnx)+6,(mxy-mny)+6
        local c=a(base,op)
        if cfg.esp_box then
          if cfg.esp_boxstyle==1 then draw.CornerBox(bx,by,bw,bh,c)
          elseif cfg.esp_boxstyle==2 then draw.Rect(bx,by,bw,bh,c,0,1)
          else draw.RectFilled(bx,by,bw,bh,{base[1],base[2],base[3],0.15*op}); draw.Rect(bx,by,bw,bh,c,0,1) end
        end
        if cfg.esp_hp then local f=clamp(p.hp/(p.mhp>0 and p.mhp or 100),0,1); draw.RectFilled(bx-5,by,3,bh,{0,0,0,0.6*op}); draw.RectFilled(bx-5,by+bh*(1-f),3,bh*f,{1-f,f,0.1,op}) end
        -- name baseline. sits above the hat apex when the hat is on, otherwise
        -- the text covers the cone and the hat is barely visible
        local ny=by-tsz-2
        if hat_v and hat_y<ny then ny=hat_y-tsz-2 end
        if cfg.esp_name and p.name then
          local tw=ts(p.name,tsz); draw.Text(bx+bw*0.5-tw*0.5,ny,p.name, cfg.esp_chroma and c or a(col.c_name,op),tsz)
        end
        if cfg.esp_dist then local dl=string.format("%.0fm",dist); local tw=ts(dl,tsz-2); draw.Text(bx+bw*0.5-tw*0.5,by+bh+2,dl,{1,1,1,op},tsz-2) end
        if cfg.esp_weapon and p.tool then local wy=by+bh+2; if cfg.esp_dist then wy=wy+(tsz-2)+1 end; local tw=ts(p.tool,tsz-2); draw.Text(bx+bw*0.5-tw*0.5,wy,p.tool,a(col.c_name,0.85*op),tsz-2) end
        if cfg.esp_tracer then local oy=(cfg.esp_tracer_from==1) and sh or ((cfg.esp_tracer_from==3) and 0 or sh*0.5); draw.Line(cx,oy,bx+bw*0.5,by+bh, cfg.esp_chroma and c or a(col.c_tracer,op),1) end
      end
      if cfg.esp_head and head then
        local sx,sy,v=AC.proj(head)
        if v then
          local hr=cfg.esp_head_size or 3
          if cfg.esp_head_style==2 then draw.Circle(sx,sy,hr,a(base,op),16,math.max(1,math.floor(hr*0.4)))
          else draw.CircleFilled(sx,sy,hr,a(base,op),12) end
        end
      end
      if cfg.esp_hat and head then
        -- wireframe "china hat": a cone built in world space around the head
        -- bone, so it sits ON the head dot instead of being pasted on the same
        -- pixel. roblox Y is up, so the brim ring lives in the XZ plane and the
        -- apex sits above it. drawn as lines only - wireframe, no fill.
        local brimy=head.y+0.44*hat_s
        local rad=0.62*hat_s
        local ax2,ay2,av=hat_x,hat_y,hat_v
        local hc=cfg.esp_chroma and base or (col.c_hat or base)
        if av then
          local xs,ys,ds={},{},{}
          local ok=true
          for i=0,15 do
            local t=i/16*math.pi*2
            local wx=head.x+math.cos(t)*rad; local wz=head.z+math.sin(t)*rad
            local sx,sy,v=W2S(wx,brimy,wz)
            if not v then ok=false; break end
            xs[i+1]=sx; ys[i+1]=sy; ds[i+1]=cam_dist(wx,brimy,wz)
          end
          if ok then
            local hd=cam_dist(head.x,head.y,head.z)
            -- rim of the brim, drawn as a closed ring
            for i=1,16 do
              local j=i%16+1
              local dd=(ds[i]+ds[j])*0.5
              local k=(dd>hd) and 0.40 or 1
              draw.Line(xs[i],ys[i],xs[j],ys[j], a(hc,op*k*0.85), 1)
            end
            -- ribs from the apex down to every other rim point
            for i=1,16,2 do
              local k=(ds[i]>hd) and 0.40 or 1
              draw.Line(ax2,ay2,xs[i],ys[i], a(hc,op*k), 1)
            end
          end
        end
      end
      if cfg.esp_skel then
        -- project each bone ONCE per player per frame. SKELETON has 9 segments and
        -- 10 distinct bones, so the naive form issued 18 engine projections per
        -- player. the projection is memoised on the bone itself (AC.proj), which
        -- also removes the per-player sx_cache table - the bone tables are rebuilt
        -- every frame, so the memo can never be stale. W2S is the dominant
        -- per-player cost, so this is where the win is.
        for _,pr in ipairs(SKELETON) do
          local b1=p.bones[pr[1]]; local b2=p.bones[pr[2]]
          if b1 and b2 then
            local x1,y1,v1=AC.proj(b1)
            local x2,y2,v2=AC.proj(b2)
            if v1 and v2 then draw.Line(x1,y1,x2,y2,a(base,0.9*op),1) end
          end
        end
      end
      if cfg.esp_off and not mnx and head then
        local ang=offscreen_dir(head.x,head.y,head.z)
        if ang then local r=math.min(sw,sh)*0.38; local axx=cx+math.cos(ang)*r; local ayy=cy+math.sin(ang)*r; local s2=9
          local pts={{axx+math.cos(ang)*s2,ayy+math.sin(ang)*s2},{axx+math.cos(ang+2.5)*s2,ayy+math.sin(ang+2.5)*s2},{axx+math.cos(ang-2.5)*s2,ayy+math.sin(ang-2.5)*s2}}
          if draw.PolyFilled then pcall(draw.PolyFilled, pts, a(base,0.9*op)) else draw.CircleFilled(axx,ayy,6,a(base,0.9*op),3) end
        end
      end
    end
  end
end

local PARTCLS={Part=true,MeshPart=true,UnionOperation=true,WedgePart=true}
local obj_cache={}; local obj_last=-1
local function find_part(inst,depth) for _,c in ipairs(call(function() return inst:GetChildren() end) or {}) do if PARTCLS[c.ClassName] then return c end end
  if depth>0 then for _,c in ipairs(call(function() return inst:GetChildren() end) or {}) do if c.ClassName=="Model" or c.ClassName=="Folder" then local r=find_part(c,depth-1); if r then return r end end end end return nil end
local GADGETS={
  Bomb={"BOMB","obj_bomb","c_bomb"}, Defuser={"DEFUSER","obj_bomb","c_bomb"},
  Claymore={"CLAYMORE","obj_traps","c_claymore"}, ProximityAlarm={"PROX ALARM","obj_traps","c_claymore"},
  NeedleMine={"NEEDLE MINE","obj_traps","c_claymore"}, ToxicCharge={"TOXIC","obj_traps","c_claymore"},
  BarbedWire={"BARBED WIRE","obj_traps","c_claymore"}, ShockBattery={"SHOCK BAT","obj_traps","c_claymore"},
  BreachCharge={"BREACH","obj_breach","c_breach"}, RemoteC4={"C4","obj_breach","c_breach"},
  HardBreachCharge={"HARD BREACH","obj_breach","c_breach"}, ThermiteCharge={"THERMITE","obj_breach","c_breach"},
  IncendiaryCanister={"INC CANISTER","obj_breach","c_breach"},
  Drone={"DRONE","obj_cam","c_cam"}, StickyCamera={"STICKY CAM","obj_cam","c_cam"},
